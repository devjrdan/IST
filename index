<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Asesmen IST Digital</title>
  <style>
    :root { --primary: #2563eb; --primary-dark: #1d4ed8; --bg: #f8fafc; --surface: #ffffff; --text: #1e293b; --muted: #64748b; --border: #e2e8f0; }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 20px; display: flex; justify-content: center; min-height: 100vh; }
    .container { background: var(--surface); width: 100%; max-width: 800px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid var(--border); overflow: hidden; display: flex; flex-direction: column; }
    
    /* Header & Timer */
    .header { background: var(--primary); color: white; padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; }
    .header h2 { font-size: 1.1rem; font-weight: 600; }
    .timer-badge { background: rgba(0,0,0,0.2); padding: 6px 12px; border-radius: 6px; font-weight: 700; font-family: monospace; font-size: 1.2rem; }
    
    .body { padding: 32px 24px; flex-grow: 1; }
    h1 { color: var(--primary); margin-bottom: 12px; }
    p { color: var(--muted); margin-bottom: 24px; line-height: 1.6; }
    
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }
    .form-group input { width: 100%; padding: 12px; border-radius: 6px; border: 1px solid var(--border); }
    
    .btn { background: var(--primary); color: white; border: none; padding: 12px 24px; font-weight: 600; border-radius: 6px; cursor: pointer; display: inline-block; }
    .btn:hover { background: var(--primary-dark); }
    .btn:disabled { background: #94a3b8; cursor: not-allowed; }
    .btn-outline { background: white; color: var(--text); border: 1px solid var(--border); }
    
    /* Screen Management */
    .screen { display: none; }
    .screen.active { display: block; }
    
    /* Question UI */
    .q-text { font-size: 1.15rem; font-weight: 600; margin-bottom: 16px; }
    .q-image { max-width: 100%; border-radius: 6px; margin-bottom: 16px; border: 1px solid var(--border); }
    
    .options-grid { display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px; }
    .option-lbl { display: flex; align-items: center; padding: 12px 16px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: 0.2s; }
    .option-lbl:hover { background: #f1f5f9; }
    .option-lbl input { margin-right: 12px; transform: scale(1.2); }
    
    .grid-nav { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); }
    .nav-btn { width: 36px; height: 36px; border-radius: 6px; border: 1px solid var(--border); background: #f8fafc; cursor: pointer; font-weight: 600; }
    .nav-btn.answered { background: #dbeafe; color: var(--primary); border-color: var(--primary); }
    .nav-btn.current { border: 2px solid var(--primary-dark); }
    
    .footer { display: flex; justify-content: space-between; margin-top: 20px; }
  </style>
  <!-- Load Database dan Scoring Engine -->
  <script src="bank_soal.js"></script>
  <script src="norma.js"></script>
</head>
<body>

<div class="container">
  <div class="header">
    <h2 id="header-title">IST Digital</h2>
    <div class="timer-badge" id="timer-display">--:--</div>
  </div>
/* --- STYLING OPSI 2: LIKERT / DIGIT SELECTOR (IST RA) --- */
.digit-scale-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24px 0;
  gap: 12px;
}

.digit-scale-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--muted, #64748b);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.digit-row {
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 540px;
}

.btn-digit-scale {
  width: 44px;
  height: 48px;
  border-radius: 8px;
  border: 2px solid var(--border, #cbd5e1);
  background: #ffffff;
  color: #1e293b;
  font-size: 1.25rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease-in-out;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.btn-digit-scale:hover {
  border-color: #107c41;
  background: #f0fdf4;
}

/* Status saat digit dicoret/dipilih */
.btn-digit-scale.active {
  background: #107c41 !important;
  color: #ffffff !important;
  border-color: #0b5a2f !important;
  box-shadow: 0 4px 10px rgba(16, 124, 65, 0.35);
  transform: translateY(-2px);
}

.selected-preview {
  font-size: 0.9rem;
  color: var(--muted, #64748b);
  min-height: 22px;
}

.selected-preview strong {
  color: #107c41;
}

  <!-- Screen 1: SETUP -->
  <div id="screen-setup" class="body screen active">
    <h1>Intelligenz Struktur Test (IST)</h1>
    <p>Tes ini terdiri dari 9 bagian dengan batas waktu yang ketat. Sistem akan memindahkan layar secara otomatis apabila waktu habis. Kerjakan secepat dan seteliti mungkin.</p>
    <div class="form-group">
      <label>Nama Lengkap</label>
      <input type="text" id="user-name" placeholder="Masukkan nama" required>
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" id="user-email" placeholder="email@domain.com" required>
    </div>
    <button class="btn" onclick="startEngine()">Mulai Rangkaian Tes</button>
  </div>

<!-- Screen 2: INSTRUCTION -->
  <div id="screen-instruction" class="body screen">
    <h1 id="inst-title">Judul Subtes</h1>
    
    <!-- ELEMEN BARU: Penampung Gambar Instruksi -->
    <img id="inst-image" src="" style="display:none; width: 100%; max-width: 650px; margin: 0 auto 20px auto; border: 1px solid var(--border); border-radius: 6px;">
    
    <!-- ELEMEN DIUPDATE: Berubah jadi <div> agar mendukung format paragraf HTML -->
    <div id="inst-text" style="margin-bottom: 24px; line-height: 1.6; color: var(--muted);">Penjelasan Subtes</div>
    
    <p style="color: #dc2626; font-weight: 600;">Waktu Mengerjakan: <span id="inst-time"></span></p>
    <button class="btn" onclick="beginSubtest()">Mulai Subtes Ini</button>
  </div>

  <!-- Screen 3: MEMORY PHASE (KHUSUS SUBTES 9) -->
  <div id="screen-memory" class="body screen">
    <h1>Fase Menghafal</h1>
    <p>Hafalkan kata-kata pada tabel di bawah ini. Waktu Anda 3 menit sebelum soal dimunculkan.</p>
    <img id="mem-image" class="q-image" src="" alt="Loading gambar...">
  </div>

<!-- Screen 4: TEST RUNTIME -->
    <div id="screen-test" class="screen" style="display: none; padding: 24px;">
      <!-- Header HUD Soal -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
        <span id="test-subtest-name" style="font-weight: 700; color: #107c41; font-size: 1.05rem;">Subtes 5: Berhitung (RA)</span>
        <span id="test-q-counter" style="font-weight: 600; color: #64748b; font-size: 0.9rem;">Soal 1 / 20</span>
      </div>

      <!-- Teks Pertanyaan -->
      <div id="test-question-body" style="font-size: 1.15rem; line-height: 1.6; color: #1e293b; min-height: 70px; margin-bottom: 20px;">
        <!-- Teks soal akan dirender secara dinamis di sini -->
      </div>

      <!-- Wadah Interaktif: Berisi Tombol Angka (RA), Pilihan Ganda (MC), atau Input Teks (GE) -->
      <div id="test-input-wrapper"></div>

      <!-- Tombol Navigasi / Submit Jawaban -->
      <div style="margin-top: 32px; display: flex; justify-content: flex-end;">
        <button id="btn-next-question" class="btn" style="width: auto; min-width: 180px; padding: 12px 28px;" onclick="handleSubmitAnswer()">
          Lanjut Soal Berikutnya ➔
        </button>
      </div>
    </div>

  <!-- Screen 5: FINISH -->
  <div id="screen-finish" class="body screen" style="text-align: center;">
    <h1>Asesmen Selesai</h1>
    <p id="finish-msg">Mengirim jawaban Anda ke server...</p>
  </div>
</div>

<script>
  const WEBHOOK_URL = "URL_WEBHOOK_GOOGLESHEET_KAMU"; // GANTI DENGAN LINK APPS SCRIPT
  
  let candidate = {};
  let state = {
    subIdx: 0,
    qIdx: 0,
    answers: {}, // Format: { "SE": { 0: "A", 1: "C" }, "WA": ... }
    timeLeft: 0,
    timerObj: null,
    isMemoryPhase: false
  };

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }

  function formatTime(sec) {
    let m = Math.floor(sec / 60).toString().padStart(2, '0');
    let s = (sec % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function startEngine() {
    candidate.name = document.getElementById("user-name").value.trim();
    candidate.email = document.getElementById("user-email").value.trim();
    if (!candidate.name || !candidate.email) return alert("Isi data diri!");
    
    if (localStorage.getItem("ist_done_" + candidate.email)) {
      return alert("Akun ini sudah menyelesaikan tes.");
    }

    state.subIdx = 0;
    state.answers = {};
    loadInstruction();
  }

function loadInstruction() {
    if (state.subIdx >= IST_DATA.length) {
      submitAllData();
      return;
    }

    const sub = IST_DATA[state.subIdx];
    document.getElementById("header-title").innerText = sub.name;
    document.getElementById("timer-display").innerText = "--:--";
    
    document.getElementById("inst-title").innerText = sub.name;
    
    // Perubahan 1: Memakai innerHTML agar tulisan instruksi bisa ditebalkan (Bold) atau di-Enter (<br>)
    document.getElementById("inst-text").innerHTML = sub.instruction;
    
    // Perubahan 2: Logika pemanggilan gambar instruksi
    const instImg = document.getElementById("inst-image");
    if (sub.instructionImage) {
      instImg.src = sub.instructionImage;
      instImg.style.display = "block";
    } else {
      instImg.style.display = "none";
    }
    
    let timeStr = sub.type === "memory" ? 
      `${sub.durationMemorySec / 60} Menit Hafalan + ${sub.durationSec / 60} Menit Pengerjaan` : 
      `${sub.durationSec / 60} Menit`;
      
    document.getElementById("inst-time").innerText = timeStr;
    showScreen("screen-instruction");
  }

  function beginSubtest() {
    const sub = IST_DATA[state.subIdx];
    state.qIdx = 0;
    if (!state.answers[sub.id]) state.answers[sub.id] = {};

    if (sub.type === "memory" && !state.isMemoryPhase) {
      // Masuk fase menghafal
      state.isMemoryPhase = true;
      document.getElementById("mem-image").src = sub.memoryImage || "";
      showScreen("screen-memory");
      startTimer(sub.durationMemorySec, endMemoryPhase);
    } else {
      // Masuk fase soal
      showScreen("screen-test");
      buildGrid();
      renderQuestion();
      startTimer(sub.durationSec, forceNextSubtest);
    }
  }

  function endMemoryPhase() {
    state.isMemoryPhase = false;
    clearInterval(state.timerObj);
    beginSubtest(); // Lanjut ke fase soal subtes 9
  }

  function startTimer(seconds, timeoutCallback) {
    clearInterval(state.timerObj);
    state.timeLeft = seconds;
    document.getElementById("timer-display").innerText = formatTime(state.timeLeft);
    
    state.timerObj = setInterval(() => {
      state.timeLeft--;
      document.getElementById("timer-display").innerText = formatTime(state.timeLeft);
      if (state.timeLeft <= 0) {
        clearInterval(state.timerObj);
        timeoutCallback();
      }
    }, 1000);
  }

  function renderQuestion() {
    const sub = IST_DATA[state.subIdx];
    const q = sub.questions[state.qIdx];
    
    document.getElementById("q-num").innerText = `${state.qIdx + 1} dari ${sub.questions.length}`;
    document.getElementById("q-content").innerText = q.q;

    // Handle Image
    const imgEl = document.getElementById("q-img");
    if (q.image) {
      imgEl.src = q.image;
      imgEl.style.display = "block";
    } else {
      imgEl.style.display = "none";
    }

    // Handle Input Area
    const ansArea = document.getElementById("answer-area");
    ansArea.innerHTML = "";
    let savedAns = state.answers[sub.id][state.qIdx] || "";

    if (sub.type === "mc" || sub.type === "memory") {
      q.options.forEach(opt => {
        let val = opt.charAt(0); // Ambil "A" dari "A. Jawaban"
        let checked = savedAns === val ? "checked" : "";
        ansArea.innerHTML += `
          <label class="option-lbl">
            <input type="radio" name="ist_opt" value="${val}" ${checked} onclick="saveAns('${val}')">
            ${opt}
          </label>
        `;
      });
    } else if (sub.type === "input") {
      ansArea.innerHTML = `
        <div class="form-group">
          <input type="text" id="text_ans" placeholder="Ketik jawaban di sini..." value="${savedAns}" onblur="saveAns(this.value)">
        </div>
      `;
    }

    // Button States
    document.getElementById("btn-prev").disabled = (state.qIdx === 0);
    let btnNext = document.getElementById("btn-next");
    if (state.qIdx === sub.questions.length - 1) {
      btnNext.innerText = "Akhiri Subtes Ini";
      btnNext.onclick = forceNextSubtest; // Tombol submit manual
    } else {
      btnNext.innerText = "Selanjutnya";
      btnNext.onclick = () => changeQ(1);
    }

    updateGridColor();
  }

  function saveAns(val) {
    const subId = IST_DATA[state.subIdx].id;
    state.answers[subId][state.qIdx] = val;
    updateGridColor();
  }

  function changeQ(dir) {
    // Save text input if typing before moving
    const textInput = document.getElementById("text_ans");
    if (textInput) saveAns(textInput.value);

    state.qIdx += dir;
    renderQuestion();
  }

  function goToQ(idx) {
    const textInput = document.getElementById("text_ans");
    if (textInput) saveAns(textInput.value);
    
    state.qIdx = idx;
    renderQuestion();
  }

  function buildGrid() {
    const grid = document.getElementById("q-grid");
    const totalQ = IST_DATA[state.subIdx].questions.length;
    grid.innerHTML = "";
    for (let i = 0; i < totalQ; i++) {
      grid.innerHTML += `<button class="nav-btn" id="grid-btn-${i}" onclick="goToQ(${i})">${i + 1}</button>`;
    }
  }

  function updateGridColor() {
    const subId = IST_DATA[state.subIdx].id;
    const totalQ = IST_DATA[state.subIdx].questions.length;
    for (let i = 0; i < totalQ; i++) {
      let btn = document.getElementById(`grid-btn-${i}`);
      if (!btn) continue;
      
      btn.classList.remove("current", "answered");
      if (i === state.qIdx) btn.classList.add("current");
      if (state.answers[subId][i]) btn.classList.add("answered");
    }
  }

  function forceNextSubtest() {
    // Pindah ke subtes berikutnya
    const textInput = document.getElementById("text_ans");
    if (textInput) saveAns(textInput.value);
    
    clearInterval(state.timerObj);
    state.subIdx++;
    loadInstruction();
  }

  function submitAllData() {
    showScreen("screen-finish");
    document.getElementById("timer-display").innerText = "SELESAI";
    
    // Kalkulasi pakai norma.js
    const scores = calculateIST(state.answers);
    
    const payload = {
      timestamp: new Date().toLocaleString("id-ID"),
      name: candidate.name,
      email: candidate.email,
      rawScores: scores.rawScores,
      totalRW: scores.totalRW,
      answersJSON: JSON.stringify(state.answers)
    };

    localStorage.setItem("ist_done_" + candidate.email, "true");

    // Pengiriman Non-Blocking (Background Fetch)
    fetch(WEBHOOK_URL, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "text/plain" },
      body: JSON.stringify(payload)
    }).then(() => {
      document.getElementById("finish-msg").innerHTML = 
        `<span style="color: #107c41; font-weight: 700;">Data berhasil terkirim.</span><br>Silakan konfirmasi ke penguji Anda.`;
    }).catch(e => {
      document.getElementById("finish-msg").innerHTML = "Selesai. Terjadi kendala visualisasi jaringan, namun log lokal aman.";
    });
  }
</script>
// VARIABEL STATE RUNTIME
let currentSelectedDigits = [];
let userAnswers = {}; // Menampung hasil jawaban kandidat

/**
 * 1. Fungsi Utama Render Soal
 */
function renderQuestion() {
  const currentSubtest = subtests[currentSubtestIndex]; // Mengambil subtes aktif
  const currentQ = currentSubtest.questions[currentQuestionIndex];
  
  // Update HUD
  document.getElementById("test-subtest-name").innerText = currentSubtest.name;
  document.getElementById("test-q-counter").innerText = `Soal ${currentQuestionIndex + 1} / ${currentSubtest.questions.length}`;
  document.getElementById("test-question-body").innerText = currentQ.q;
  
  const container = document.getElementById("test-input-wrapper");
  container.innerHTML = "";
  currentSelectedDigits = []; // Reset pilihan digit untuk soal baru

  // Update Teks Tombol di Nomor Terakhir
  const btnNext = document.getElementById("btn-next-question");
  if (currentQuestionIndex === currentSubtest.questions.length - 1) {
    btnNext.innerText = "Selesaikan Subtes ✓";
  } else {
    btnNext.innerText = "Lanjut Soal Berikutnya ➔";
  }

  // --- KONDISI A: Subtes 5 (RA) Tipe Digit Selector ala Lembar Jawab Asli IST ---
  if (currentSubtest.id === "RA" || currentSubtest.type === "digit_select") {
    const digitList = [1, 2, 3, 4, 5, 6, 7, 8, 9, 0];
    
    let html = `
      <div class="digit-scale-container">
        <div class="digit-scale-label">Pilih seluruh digit penyusun jawaban Anda:</div>
        <div class="digit-row">
          ${digitList.map(num => `
            <button type="button" class="btn-digit-scale" id="digit-chip-${num}" onclick="toggleDigitSelection(${num})">
              ${num}
            </button>
          `).join("")}
        </div>
        <div class="selected-preview" id="selected-preview-text">Digit dipilih: <em>(Belum ada)</em></div>
      </div>
    `;
    container.innerHTML = html;
  } 
  
  // --- KONDISI B: Subtes Isian Teks Bebas (Misal Subtes 4: GE) ---
  else if (currentSubtest.type === "input") {
    container.innerHTML = `
      <div style="max-width: 480px; margin: 20px auto;">
        <input type="text" id="raw-text-answer" class="form-control" placeholder="Ketik jawaban Anda di sini..." autocomplete="off" style="width: 100%; padding: 12px; font-size: 1.05rem;" />
      </div>
    `;
    setTimeout(() => document.getElementById("raw-text-answer")?.focus(), 100);
  }

  // --- KONDISI C: Subtes Pilihan Ganda Biasa (MC) ---
  else if (currentSubtest.type === "mc") {
    container.innerHTML = `
      <div style="display: flex; flex-direction: column; gap: 10px; max-width: 580px; margin: 16px auto;">
        ${currentQ.options.map(opt => `
          <button type="button" class="btn btn-outline" style="text-align: left; padding: 12px 18px;" onclick="selectMCOption('${opt[0]}')">
            ${opt}
          </button>
        `).join("")}
      </div>
    `;
  }
}

/**
 * 2. Logika Toggle Seleksi Digit Angka (Subtes RA)
 */
function toggleDigitSelection(digit) {
  const chip = document.getElementById(`digit-chip-${digit}`);
  const idx = currentSelectedDigits.indexOf(digit);

  if (idx > -1) {
    // Jika sudah terpilih -> batalkan pilihan
    currentSelectedDigits.splice(idx, 1);
    chip.classList.remove("active");
  } else {
    // Jika belum terpilih -> tambahkan ke daftar
    currentSelectedDigits.push(digit);
    chip.classList.add("active");
  }

  // Tampilkan preview angka yang dipilih secara realtime
  const preview = document.getElementById("selected-preview-text");
  if (currentSelectedDigits.length === 0) {
    preview.innerHTML = "Digit dipilih: <em>(Belum ada)</em>";
  } else {
    // Urutkan angka agar rapi dilihat
    const sorted = [...currentSelectedDigits].sort((a, b) => a - b);
    preview.innerHTML = `Digit dipilih: <strong>[ ${sorted.join(", ")} ]</strong>`;
  }
}

/**
 * 3. Handler Tombol Submit / Lanjut Soal
 */
function handleSubmitAnswer() {
  const currentSubtest = subtests[currentSubtestIndex];
  const currentQ = currentSubtest.questions[currentQuestionIndex];
  
  let finalAnswerRecorded = null;
  let isCorrectScore = 0;

  // Evaluasi jika bertipe Digit Selector (RA)
  if (currentSubtest.id === "RA" || currentSubtest.type === "digit_select") {
    finalAnswerRecorded = [...currentSelectedDigits].sort((a, b) => a - b);

    // Kunci jawaban dari bank_soal (misal: [3, 5] untuk hasil 35)
    const targetKeyDigits = [...currentQ.digits].sort((a, b) => a - b);

    // Validasi kesamaan elemen tanpa peduli urutan klik peserta
    const isSameLength = finalAnswerRecorded.length === targetKeyDigits.length;
    const isMatched = isSameLength && finalAnswerRecorded.every((val, i) => val === targetKeyDigits[i]);
    isCorrectScore = isMatched ? 1 : 0;
  }
  // Evaluasi isian teks (GE)
  else if (currentSubtest.type === "input") {
    const rawVal = document.getElementById("raw-text-answer")?.value || "";
    finalAnswerRecorded = rawVal.trim();
    isCorrectScore = gradeGEAnswer(finalAnswerRecorded, currentQ); // Menggunakan auto-grader GE sebelumnya
  }

  // Rekam ke koleksi data jawaban
  if (!userAnswers[currentSubtest.id]) userAnswers[currentSubtest.id] = [];
  userAnswers[currentSubtest.id].push({
    questionNo: currentQuestionIndex + 1,
    jawabanPeserta: finalAnswerRecorded,
    skor: isCorrectScore
  });

  // Navigasi ke nomor berikutnya atau lanjut ke subtes berikutnya
  if (currentQuestionIndex < currentSubtest.questions.length - 1) {
    currentQuestionIndex++;
    renderQuestion();
  } else {
    finishCurrentSubtest();
  }
}
</body>
</html>
